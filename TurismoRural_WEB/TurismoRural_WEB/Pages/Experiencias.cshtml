@page
@model TurismoRural_WEB.Pages.ExperienciasModel
@{
    ViewData["Title"] = "Mis Experiencias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/reservations.css" />

@Html.AntiForgeryToken()

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <h1>Mis Experiencias</h1>
        <p>Visualiza todas tus experiencias disponibles. Desde aquí puedes gestionar las sesiones de cada una.</p>
    </div>

    <div style="margin-bottom: 30px; text-align: right;">
        <button class="card-button" onclick="mostrarModalCrear()" style="background: linear-gradient(135deg, #10b981, #059669); padding: 12px 24px;">+ Nueva Experiencia</button>
    </div>

    <!-- Filters Section -->
    <div style="background: white; border-radius: 12px; padding: 30px; margin-bottom: 40px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.1); border: 2px solid #f0fdf4;">
        <div style="font-size: 1.3rem; font-weight: 700; color: #10b981; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">🔍 Filtrar Experiencias</div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 20px;">
            <div>
                <label for="nombreFiltro" style="font-weight: 600; color: #333; margin-bottom: 8px; display: block;">Buscar por título:</label>
                <input type="text" id="nombreFiltro" placeholder="Ej: Tour en canopy..." style="width: 100%; padding: 12px 15px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 0.95rem; background-color: #fafafa;" />
            </div>
            <div>
                <label for="categoriaFiltro" style="font-weight: 600; color: #333; margin-bottom: 8px; display: block;">Filtrar por categoría:</label>
                <select id="categoriaFiltro" style="width: 100%; padding: 12px 15px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 0.95rem; background-color: #fafafa;">
                    <option value="">Todas las categorías</option>
                </select>
            </div>
        </div>
        <div style="display: flex; gap: 10px;">
            <button class="card-button" onclick="renderizarTabla()" style="flex: 1; background: linear-gradient(135deg, #10b981, #059669); padding: 12px 20px;">🔎 Filtrar</button>
            <button class="card-button" onclick="limpiarFiltros()" style="flex: 1; background: white; color: #10b981; border: 2px solid #10b981; padding: 12px 20px;">✖️ Limpiar</button>
        </div>
    </div>

    <!-- Experiencias Content -->
    <div id="experienciasContent">
        <!-- Experiencias se cargarán aquí -->
    </div>

    <!-- Info Section -->
    <div class="info-section">
        <h3>💡 Sobre tus Experiencias</h3>
        <ul>
            <li>Cada experiencia base contiene la información general de la actividad (título, descripción, categoría)</li>
            <li>Para cada experiencia puedes crear múltiples sesiones con diferentes fechas, horarios y cupos</li>
            <li>Las sesiones son las que aparecen disponibles para que los turistas hagan reservas</li>
            <li>Ve a "Sesiones" para crear instancias específicas de tus experiencias</li>
        </ul>
    </div>

    <!-- Footer -->
    <div class="footer-section">
        <a href="@Url.Page("/Index")" class="back-button">← Volver al Inicio</a>
        <p>¿Necesitas ayuda? Contacta a nuestro equipo de soporte</p>
    </div>
</div>

<!-- Modal Nueva Experiencia -->
<div id="modalCrearExp" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:12px; padding:40px; max-width:500px; width:90%; max-height:90vh; overflow-y:auto;">
        <h3 style="color:#10b981; margin-bottom:20px;">🎯 Nueva Experiencia</h3>
        <div style="margin-bottom:15px;">
            <label style="font-weight:600; color:#333; display:block; margin-bottom:8px;">Título: <span style="color:#dc2626;">*</span></label>
            <input type="text" id="expTitulo" maxlength="50" placeholder="Ej: Tour en canopy" style="width:100%; padding:12px; border:2px solid #e5e7eb; border-radius:8px; font-size:1rem; box-sizing:border-box;" />
        </div>
        <div style="margin-bottom:15px;">
            <label style="font-weight:600; color:#333; display:block; margin-bottom:8px;">Descripción:</label>
            <textarea id="expDescripcion" maxlength="150" rows="3" placeholder="Descripción de la experiencia..." style="width:100%; padding:12px; border:2px solid #e5e7eb; border-radius:8px; font-size:1rem; resize:vertical; box-sizing:border-box;"></textarea>
        </div>
        <div style="margin-bottom:15px;">
            <label style="font-weight:600; color:#333; display:block; margin-bottom:8px;">Categoría:</label>
            <input type="text" id="expCategoria" maxlength="150" placeholder="Ej: Aventura, Naturaleza, Deportes..." style="width:100%; padding:12px; border:2px solid #e5e7eb; border-radius:8px; font-size:1rem; box-sizing:border-box;" />
        </div>
        <div style="margin-bottom:20px;">
            <label style="font-weight:600; color:#333; display:block; margin-bottom:8px;">Comunidad: <span style="color:#dc2626;">*</span></label>
            <select id="expComunidad" style="width:100%; padding:12px; border:2px solid #e5e7eb; border-radius:8px; font-size:1rem; background:#fafafa; box-sizing:border-box;">
                <option value="">Cargando comunidades...</option>
            </select>
        </div>
        <div id="crearExpMsg" style="margin-bottom:15px; display:none;"></div>
        <div style="display:flex; gap:10px;">
            <button onclick="guardarExperiencia()" class="card-button" style="flex:1; background:linear-gradient(135deg,#10b981,#059669);">Guardar</button>
            <button onclick="cerrarModalCrearExp()" class="card-button" style="flex:1; background:white; color:#10b981; border:2px solid #10b981;">Cancelar</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let experiencias = [];
    let categorias = new Set();

    // Cargar experiencias desde el servidor
    async function cargarExperiencias() {
        try {
            const loader = document.getElementById('experienciasContent');
            loader.innerHTML = '<div style="text-align: center; padding: 40px; color: #10b981; font-weight: 600;">Cargando experiencias...</div>';

            const response = await fetch(window.location.pathname + '?handler=GetExperiencias', {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            });

            if (!response.ok) throw new Error(`Error: ${response.status}`);

            const data = await response.json();
            console.log('Experiencias:', data);

            // Mapear respuesta
            experiencias = data.map(item => ({
                id: item.id || item.iD_Experiencia,
                titulo: item.titulo || item.nombre,
                descripcion: item.descripcion,
                categoria: item.categoria || 'Sin categoría',
                usuarioId: item.usuarioIdRegistrador,
                comunidadId: item.iD_Comunidad,
                nombreComunidad: item.nombre_Comunidad || 'Comunidad desconocida'
            }));

            // Extraer categorías únicas
            categorias.clear();
            experiencias.forEach(exp => {
                if (exp.categoria) {
                    categorias.add(exp.categoria);
                }
            });

            // Llenar selector de categorías
            const selectCategoria = document.getElementById('categoriaFiltro');
            selectCategoria.innerHTML = '<option value="">Todas las categorías</option>';
            Array.from(categorias).sort().forEach(cat => {
                selectCategoria.innerHTML += `<option value="${cat}">${cat}</option>`;
            });

            renderizarTabla();
        } catch (error) {
            console.error('Error:', error);
            document.getElementById('experienciasContent').innerHTML = `
                <div style="text-align: center; padding: 60px 20px; background: #f0fdf4; border-radius: 12px; margin: 40px 0;">
                    <div style="font-size: 4rem; margin-bottom: 20px;">⚠️</div>
                    <h3 style="color: #10b981; font-size: 1.5rem; margin-bottom: 10px;">Error al cargar experiencias</h3>
                    <p style="color: #666; font-size: 1rem; margin-bottom: 10px;">No pudimos cargar los datos.</p>
                    <p style="color: #999; font-size: 0.85rem; margin-bottom: 25px;"><strong>Error:</strong> ${error.message}</p>
                    <button class="card-button" onclick="cargarExperiencias()" style="background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 14px 32px; border: none; border-radius: 10px; font-weight: 700; font-size: 1rem; text-decoration: none; cursor: pointer;">🔄 Reintentar</button>
                </div>
            `;
        }
    }

    function renderizarTabla() {
        const nombreFiltro = document.getElementById('nombreFiltro')?.value?.toLowerCase() || '';
        const categoriaFiltro = document.getElementById('categoriaFiltro')?.value || '';

        let experienciasFiltradas = experiencias.filter(e => {
            const cumpleTitulo = !nombreFiltro || (e.titulo && e.titulo.toLowerCase().includes(nombreFiltro));
            const cumpleCategoria = !categoriaFiltro || e.categoria === categoriaFiltro;
            return cumpleTitulo && cumpleCategoria;
        });

        // Ordenar por título
        experienciasFiltradas.sort((a, b) => a.titulo.localeCompare(b.titulo));

        const contenido = document.getElementById('experienciasContent');

        if (experienciasFiltradas.length === 0) {
            contenido.innerHTML = `
                <div style="text-align: center; padding: 60px 20px; background: #f0fdf4; border-radius: 12px; margin: 40px 0;">
                    <div style="font-size: 4rem; margin-bottom: 20px;">📭</div>
                    <h3 style="color: #10b981; font-size: 1.5rem; margin-bottom: 10px;">No hay experiencias</h3>
                    <p style="color: #666; font-size: 1rem; margin-bottom: 25px;">No encontramos experiencias que coincidan con tus filtros.</p>
                    <button class="card-button" onclick="limpiarFiltros()" style="background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 14px 32px; border: none; border-radius: 10px; font-weight: 700; font-size: 1rem; cursor: pointer;">🔄 Limpiar filtros</button>
                </div>
            `;
            return;
        }

        let html = '<div class="cards-grid">';
        experienciasFiltradas.forEach(e => {
            html += `
                <div class="card-module">
                    <div class="card-icon" style="background: linear-gradient(135deg, #10b981, #34d399); font-size: 2rem;">🎯</div>
                    <div class="card-content">
                        <div style="font-size: 0.8rem; color: #10b981; background: #f0fdf4; padding: 4px 12px; border-radius: 20px; margin-bottom: 8px; display: inline-block; font-weight: 600;">${e.categoria}</div>
                        <div class="card-title">${e.titulo}</div>
                        <p class="card-description">${e.descripcion}</p>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 15px 0; border-top: 1px solid #e5e7eb; margin-bottom: 15px;">
                            <div>
                                <div style="font-size: 0.75rem; color: #999;">Comunidad</div>
                                <span style="font-size: 1.1rem; font-weight: 700; color: #10b981;">${e.nombreComunidad}</span>
                            </div>
                        </div>
                        <div style="display: flex; gap: 10px;">
                            <button onclick="irASesiones('${e.id}')" class="card-button" style="flex: 1; background: linear-gradient(135deg, #10b981, #059669); color: white; padding: 10px 15px; font-size: 0.9rem; text-align: center; border: none; cursor: pointer;">📅 Ver Sesiones</button>
                        </div>
                    </div>
                </div>
            `;
        });
        html += '</div>';
        contenido.innerHTML = html;
    }

    function limpiarFiltros() {
        document.getElementById('nombreFiltro').value = '';
        document.getElementById('categoriaFiltro').value = '';
        renderizarTabla();
    }

    function irASesiones(experienciaId) {
        window.location.href = '@Url.Page("/Sesiones")' + '?experienciaId=' + experienciaId;
    }

    // Event listeners
    document.getElementById('nombreFiltro').addEventListener('input', renderizarTabla);
    document.getElementById('categoriaFiltro').addEventListener('change', renderizarTabla);

    // Cargar al inicio
    window.addEventListener('load', cargarExperiencias);

    // ============ MODAL CREAR EXPERIENCIA ============

    async function mostrarModalCrear() {
        const select = document.getElementById('expComunidad');
        select.innerHTML = '<option value="">Cargando comunidades...</option>';
        document.getElementById('expTitulo').value = '';
        document.getElementById('expDescripcion').value = '';
        document.getElementById('expCategoria').value = '';
        const msg = document.getElementById('crearExpMsg');
        msg.style.display = 'none';
        msg.innerHTML = '';
        document.getElementById('modalCrearExp').style.display = 'flex';

        try {
            const response = await fetch(window.location.pathname + '?handler=GetComunidades');
            const data = await response.json();
            select.innerHTML = '<option value="">Selecciona una comunidad...</option>';
            data.forEach(c => {
                const id = c.iD_Comunidad ?? c.id_Comunidad ?? c.id;
                const nombre = c.nombre_Comunidad ?? c.nombre ?? 'Comunidad ' + id;
                select.innerHTML += `<option value="${id}">${nombre}</option>`;
            });
        } catch {
            select.innerHTML = '<option value="">Error al cargar comunidades</option>';
        }
    }

    function cerrarModalCrearExp() {
        document.getElementById('modalCrearExp').style.display = 'none';
    }

    async function guardarExperiencia() {
        const titulo = document.getElementById('expTitulo').value.trim();
        const descripcion = document.getElementById('expDescripcion').value.trim();
        const categoria = document.getElementById('expCategoria').value.trim();
        const comunidadId = parseInt(document.getElementById('expComunidad').value);
        const msg = document.getElementById('crearExpMsg');

        if (!titulo) {
            msg.style.display = 'block';
            msg.innerHTML = '<span style="color:#dc2626;">El título es obligatorio.</span>';
            return;
        }
        if (!comunidadId) {
            msg.style.display = 'block';
            msg.innerHTML = '<span style="color:#dc2626;">Debes seleccionar una comunidad.</span>';
            return;
        }

        const btn = document.querySelector('#modalCrearExp button[onclick="guardarExperiencia()"]');
        btn.disabled = true;
        btn.textContent = 'Guardando...';
        msg.style.display = 'none';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const response = await fetch(window.location.pathname + '?handler=Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({
                    titulo: titulo,
                    descripcion: descripcion,
                    categoria: categoria,
                    iD_Comunidad: comunidadId
                })
            });
            const result = await response.json();
            if (result.success) {
                cerrarModalCrearExp();
                cargarExperiencias();
            } else {
                msg.style.display = 'block';
                msg.innerHTML = '<span style="color:#dc2626;">' + (result.error || 'No se pudo crear la experiencia.') + '</span>';
            }
        } catch (error) {
            msg.style.display = 'block';
            msg.innerHTML = '<span style="color:#dc2626;">Error: ' + error.message + '</span>';
        } finally {
            btn.disabled = false;
            btn.textContent = 'Guardar';
        }
    }
</script>
}
