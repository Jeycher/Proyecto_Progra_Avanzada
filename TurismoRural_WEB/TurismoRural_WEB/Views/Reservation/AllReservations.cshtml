@model List<TurismoRural_WEB.Models.Reservation.Reservation>
@{
    ViewData["Title"] = "Todas las Reservas";
}

<h2>📊 Todas las Reservas</h2>

@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">No hay reservas registradas.</div>
}
else
{
    <div class="alert alert-info">
        Total de reservas: <strong>@Model.Count</strong>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID Reserva</th>
                    <th>Fecha Reserva</th>
                    <th>ID Usuario</th>
                    <th>Experiencia</th>
                    <th>Cantidad Personas</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reserva in Model)
                {
                    <tr>
                        <td>@reserva.ID_Reserva</td>
                        <td>@reserva.Fecha_Reserva.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@reserva.ID_Usuario</td>
                        <td>@reserva.NombreConcurrencia</td>
                        <td>@reserva.Cantidad_Personas</td>
                        <td>
                            @switch (reserva.Estado)
                            {
                                case 1:
                                    <span class="badge bg-warning">Pendiente</span>
                                    break;
                                case 2:
                                    <span class="badge bg-success">Confirmada</span>
                                    break;
                                case 3:
                                    <span class="badge bg-danger">Cancelada</span>
                                    break;
                                case 4:
                                    <span class="badge bg-info">Completada</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Desconocido</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("SearchReservations", new { reservaId = reserva.ID_Reserva })" class="btn btn-sm btn-primary">
                                Detalles
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a href="@Url.Action("Index", "Home")" class="btn btn-secondary mt-3">
    Volver al Inicio
</a>