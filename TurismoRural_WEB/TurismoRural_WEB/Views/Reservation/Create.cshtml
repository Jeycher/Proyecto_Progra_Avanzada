@model TurismoRural_WEB.Models.Reservation.ReservationCreateViewModel
@{
    ViewData["Title"] = "Nueva Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/reservations.css" />

<div class="create-reservation-container">
    <!-- Header -->
    <div class="page-header">
        <h1>Nueva Reserva</h1>
        <p>Crea una nueva reserva para vivir una experiencia inolvidable</p>
    </div>

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert-error">
            @ViewBag.Error
        </div>
    }

    <!-- Form Card -->
    <div class="form-card">
        <div class="info-box">
            <strong>Tip:</strong> Selecciona la experiencia que deseas reservar, el número de personas y confirma tu reserva.
        </div>

        <form id="reservationForm" method="post">
            <!-- Experiencia Selection -->
            <div class="form-group">
                <label for="experiencia">Selecciona una Experiencia</label>
                <select id="experiencia" name="ID_Concurrencia" class="form-control form-select" required onchange="updateExperienceDetails()">
                    <option value="">-- Elige una experiencia --</option>
                    @foreach (var c in Model.Concurrencias)
                    {
                        <option value="@c.ID_Concurrencia" data-title="@c.TituloExperiencia" data-detail="@c.Detalle" data-price="@c.Precio" data-capacity="@c.Cupos_Disponibles">
                            @c.TituloExperiencia - @c.Detalle (@c.Fecha.ToString("dd/MM/yyyy"))
                        </option>
                    }
                </select>
            </div>

            <!-- Experience Details (Hidden until selected) -->
            <div id="experienceDetails" style="display: none; background: #f0fdf4; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 4px solid #10b981;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div>
                        <small style="color: #666;">Precio por persona</small>
                        <div style="font-size: 1.5rem; font-weight: 700; color: #10b981;">$<span id="detailPrice">0</span></div>
                    </div>
                    <div>
                        <small style="color: #666;">Cupos disponibles</small>
                        <div style="font-size: 1.5rem; font-weight: 700; color: #10b981;"><span id="detailCapacity">0</span></div>
                    </div>
                </div>
            </div>

            <!-- Cantidad de Personas -->
            <div class="form-group">
                <label for="cantidad">Cantidad de Personas</label>
                <input type="number" id="cantidad" name="Cantidad_Personas" class="form-control" min="1" max="20" placeholder="Ejemplo: 4" required />
                <small style="color: #999; display: block; margin-top: 5px;">Máximo 20 personas por reserva</small>
            </div>

            <!-- Estado fijo: Pendiente (1) -->
            <input type="hidden" id="estado" name="Estado" value="1" />

            <!-- Buttons -->
            <div class="button-group">
                <button type="submit" class="btn-primary-custom">Confirmar Reserva</button>
                <a href="@Url.Action("Dashboard", "Reservation")" class="btn-secondary-custom">Volver</a>
            </div>
        </form>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmacionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Reserva</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p style="text-align: center; color: #666; margin-bottom: 25px; font-size: 1.05rem;">
                    ¿Confirmas los datos de tu reserva?
                </p>

                <div class="modal-detail">
                    <div class="modal-detail-label">ID de Reserva</div>
                    <div class="modal-detail-value">#<span id="modalReservaId">0</span></div>
                </div>

                <div class="modal-detail">
                    <div class="modal-detail-label">Experiencia</div>
                    <div class="modal-detail-value"><span id="modalExperiencia">-</span></div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div class="modal-detail">
                        <div class="modal-detail-label">Personas</div>
                        <div class="modal-detail-value"><span id="modalCantidad">0</span></div>
                    </div>
                    <div class="modal-detail">
                        <div class="modal-detail-label">Total Estimado</div>
                        <div class="modal-detail-value">₡<span id="modalTotal">0</span></div>
                    </div>
                </div>

                <div style="background: #f0fdf4; padding: 15px; border-radius: 8px; margin-top: 20px; text-align: center; color: #666;">
                    <small>Recibirás un email de confirmación en breve. Puedes ver tus reservas en cualquier momento.</small>
                </div>
            </div>
            <div class="modal-footer" style="display: flex; gap: 10px; justify-content: center;">
                <button type="button" id="btnConfirmarReserva" class="btn-modal-primary">Confirmar</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function updateExperienceDetails() {
            const select = document.getElementById('experiencia');
            const option = select.options[select.selectedIndex];
            const detailsDiv = document.getElementById('experienceDetails');

            if (select.value) {
                document.getElementById('detailPrice').textContent = option.dataset.price;
                document.getElementById('detailCapacity').textContent = option.dataset.capacity;
                detailsDiv.style.display = 'block';
            } else {
                detailsDiv.style.display = 'none';
            }
        }

        // Pre-seleccionar la sesión si viene por URL (?concurrenciaId=X)
        (function preseleccionarSesion() {
            const params = new URLSearchParams(window.location.search);
            const concurrenciaId = params.get('concurrenciaId');
            if (!concurrenciaId) return;
            const select = document.getElementById('experiencia');
            const option = Array.from(select.options).find(o => o.value === concurrenciaId);
            if (option) {
                select.value = concurrenciaId;
                updateExperienceDetails();
            }
        })();

        document.getElementById('reservationForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const cantidad = document.getElementById('cantidad').value;
            const estado = document.getElementById('estado').value;
            const concurrencia = document.getElementById('experiencia').value;

            if (!cantidad || cantidad <= 0 || !concurrencia) {
                alert('Por favor completa todos los campos correctamente.');
                return false;
            }

            // Mostrar modal de confirmación
            const select = document.getElementById('experiencia');
            const option = select.options[select.selectedIndex];
            const price = parseFloat(option.dataset.price);
            const total = (price * cantidad).toFixed(2);

            document.getElementById('modalReservaId').textContent = Math.floor(Math.random() * 10000);
            document.getElementById('modalExperiencia').textContent = option.dataset.title;
            document.getElementById('modalCantidad').textContent = cantidad;
            document.getElementById('modalTotal').textContent = total;

            // Mostrar modal
            const modal = new bootstrap.Modal(document.getElementById('confirmacionModal'));
            modal.show();

            // Enviar formulario solo cuando el usuario confirma
            const form = this;
            document.getElementById('btnConfirmarReserva').onclick = function() {
                form.submit();
            };
        });
    </script>
}
