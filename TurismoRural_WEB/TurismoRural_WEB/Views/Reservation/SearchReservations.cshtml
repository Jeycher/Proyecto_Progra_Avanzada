@model TurismoRural_WEB.Models.Reservation.SearchReservationsViewModel
@{
    ViewData["Title"] = "Buscar Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/reservations.css" />

<div class="search-reservations-container">
    <!-- Header -->
    <div class="page-header">
        <h1>🔍 Buscar Reserva</h1>
        <p>Encuentra los detalles de cualquier reserva por ID</p>
    </div>

    <!-- Search Card -->
    <div class="search-card">
        <form method="post">
            <div class="form-group">
                <label for="reservaId">ID de Reserva</label>
                <div class="input-search">
                    <input type="number" id="reservaId" name="reservaId" class="form-control" placeholder="Ejemplo: 123" required />
                    <button type="submit" class="btn-search">🔍 Buscar</button>
                </div>
                <small style="color: #999; display: block; margin-top: 8px;">Ingresa el número de ID de la reserva que deseas consultar</small>
            </div>
        </form>
    </div>

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert-error">
            ⚠️ @ViewBag.Error
        </div>
    }

    <!-- Results -->
    @if (Model != null && Model.Reservation != null)
    {
        <div class="details-card">
            <div class="details-header">
                <h3>Reserva #@Model.Reservation.ID_Reserva</h3>
            </div>

            <div class="details-body">
                <div class="details-grid">
                    <div class="detail-item">
                        <span class="detail-label">Experiencia</span>
                        <div class="detail-value">@Model.Reservation.NombreConcurrencia</div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Fecha de Reserva</span>
                        <div class="detail-value">@Model.Reservation.Fecha_Reserva.ToString("dd/MM/yyyy")</div>
                        <small style="color: #999;">@Model.Reservation.Fecha_Reserva.ToString("HH:mm")</small>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Cantidad de Personas</span>
                        <div class="detail-value">@Model.Reservation.Cantidad_Personas</div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Usuario ID</span>
                        <div class="detail-value">#@Model.Reservation.ID_Usuario</div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Concurrencia ID</span>
                        <div class="detail-value">#@Model.Reservation.ID_Concurrencia</div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Estado</span>
                        <form method="post" action="@Url.Action("UpdateReservationStatus", "Reservation")" style="display: inline;">
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <select name="newStatus" class="form-select" style="flex: 1; max-width: 200px;">
                                    @{
                                        foreach (var estado in Model.Estados)
                                        {
                                            if (Model.Reservation.Estado == estado.ID_Estado)
                                            {
                                                @:<option value="@estado.ID_Estado" selected>@estado.Nombre</option>
                                            }
                                            else
                                            {
                                                @:<option value="@estado.ID_Estado">@estado.Nombre</option>
                                            }
                                        }
                                    }
                                </select>
                                <input type="hidden" name="reservationId" value="@Model.Reservation.ID_Reserva" />
                                <button type="submit" class="btn btn-sm btn-success">Actualizar</button>
                            </div>
                        </form>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Reservation.EstadoNombre))
                {
                    <div class="experience-highlight">
                        <div class="experience-highlight-title">Información Adicional</div>
                        <p style="margin: 0;">Estado: <strong>@Model.Reservation.EstadoNombre</strong></p>
                    </div>
                }
            </div>

            <div class="details-footer">
                <a href="@Url.Action("MyReservations", "Reservation")" class="btn-footer btn-primary-footer">
                    Mis Reservas
                </a>
                <a href="@Url.Action("Dashboard", "Reservation")" class="btn-footer btn-secondary-footer">
                    Volver al Centro
                </a>
            </div>
        </div>
    }
</div>
