@model List<TurismoRural_WEB.Models.Reservation.Reservation>
@{
    ViewData["Title"] = "Mis Reservas";
}

<h2>Mis Reservas</h2>

@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">No tienes reservas registradas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID Reserva</th>
                    <th>Fecha Reserva</th>
                    <th>Experiencia</th>
                    <th>Cantidad Personas</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reserva in Model)
                {
                    <tr>
                        <td>@reserva.ID_Reserva</td>
                        <td>@reserva.Fecha_Reserva.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@reserva.NombreConcurrencia</td>
                        <td>@reserva.Cantidad_Personas</td>
                        <td>
                            @switch (reserva.Estado)
                            {
                                case 1:
                                    <span class="badge bg-warning">Pendiente</span>
                                    break;
                                case 2:
                                    <span class="badge bg-success">Confirmada</span>
                                    break;
                                case 3:
                                    <span class="badge bg-danger">Cancelada</span>
                                    break;
                                case 4:
                                    <span class="badge bg-info">Completada</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Desconocido</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a href="#" class="btn btn-sm btn-primary">Detalles</a>
                            <a href="#" class="btn btn-sm btn-danger">Cancelar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a href="@Url.Action("Create", "Reservation")" class="btn btn-primary mt-3">
    ➕ Nueva Reserva
</a>
<a href="@Url.Action("Index", "Home")" class="btn btn-secondary mt-3">
    Volver al Inicio
</a>