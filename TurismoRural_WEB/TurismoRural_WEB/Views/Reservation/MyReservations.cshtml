@model TurismoRural_WEB.Models.Reservation.MyReservationsViewModel
@{
    ViewData["Title"] = "Mis Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/reservations.css" />

<div class="my-reservations-container">
    <!-- Header -->
    <div class="header-top">
        <div>
            <h1>📋 Mis Reservas</h1>
            <p>Gestiona todas tus reservas en un solo lugar</p>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("Create", "Reservation")" class="btn-action btn-primary-action">
                ➕ Nueva Reserva
            </a>
            <a href="@Url.Action("Dashboard", "Reservation")" class="btn-action btn-secondary-action">
                ← Volver
            </a>
        </div>
    </div>

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert-error">
            ⚠️ @ViewBag.Error
        </div>
    }

    @if (TempData["MensajeExito"] != null)
    {
        <div style="background:#f0fdf4; border:2px solid #10b981; border-radius:10px; padding:14px 20px; margin-bottom:20px; color:#065f46; font-weight:600;">
            ✅ @TempData["MensajeExito"]
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div style="background:#fef2f2; border:2px solid #dc2626; border-radius:10px; padding:14px 20px; margin-bottom:20px; color:#991b1b; font-weight:600;">
            ❌ @TempData["MensajeError"]
        </div>
    }

    <!-- Empty State -->
    @if (Model == null || Model.Reservations == null || Model.Reservations.Count == 0)
    {
        <div class="alert-empty">
            <div class="alert-empty-icon">📭</div>
            <h3>No tienes reservas aún</h3>
            <p style="margin-bottom: 20px;">¡Crea tu primera reserva y comienza tu aventura en Turismo Rural!</p>
            <a href="@Url.Action("Create", "Reservation")" class="btn-action btn-primary-action">
                Nueva Reserva
            </a>
        </div>
    }
    else
    {
        <!-- Stats -->
        <div class="stats-box">
            <span class="stats-label">Total de Reservas</span>
            <div class="stats-value">@Model.Reservations.Count</div>
        </div>

        <!-- Reservations Grid -->
        <div class="reservations-grid">
            @foreach (var reserva in Model.Reservations)
            {
                <div class="reservation-card">
                    <div class="reservation-header">
                        <div class="reservation-id">Reserva #@reserva.ID_Reserva</div>
                        <h3 class="reservation-title">@reserva.NombreConcurrencia</h3>
                    </div>

                    <div class="reservation-body">
                        <div class="reservation-detail">
                            <span class="reservation-detail-label">Fecha de Reserva</span>
                            <span class="reservation-detail-value">@reserva.Fecha_Reserva.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <div class="reservation-detail">
                            <span class="reservation-detail-label">Cantidad de Personas</span>
                            <span class="reservation-detail-value">@reserva.Cantidad_Personas personas</span>
                        </div>

                        <div class="reservation-detail">
                            <span class="reservation-detail-label">Estado</span>
                            @if (Model.EsAdmin)
                            {
                                <form method="post" action="@Url.Action("UpdateReservationStatus", "Reservation")" style="display: inline;">
                                    <div style="display: flex; gap: 10px; align-items: center;">
                                        <select name="newStatus" class="form-select" style="flex: 1; max-width: 200px;">
                                            @{
                                                foreach (var estado in Model.Estados)
                                                {
                                                    if (reserva.Estado == estado.iD_estado)
                                                    {
                                                        @:<option value="@estado.iD_estado" selected>@estado.descripcion</option>
                                                    }
                                                    else
                                                    {
                                                        @:<option value="@estado.iD_estado">@estado.descripcion</option>
                                                    }
                                                }
                                            }
                                        </select>
                                        <input type="hidden" name="reservationId"    value="@reserva.ID_Reserva" />
                                        <input type="hidden" name="userId"           value="@reserva.ID_Usuario" />
                                        <input type="hidden" name="concurrenciaId"   value="@reserva.ID_Concurrencia" />
                                        <input type="hidden" name="cantidadPersonas" value="@reserva.Cantidad_Personas" />
                                        <input type="hidden" name="returnTo"         value="MyReservations" />
                                        <button type="submit" class="btn btn-sm btn-success">Actualizar</button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                var estadoNombre = Model.Estados.FirstOrDefault(e => e.iD_estado == reserva.Estado)?.descripcion ?? reserva.Estado.ToString();
                                <span class="reservation-detail-value">@estadoNombre</span>
                            }
                        </div>
                    </div>

                    <div class="reservation-footer">
                        <form method="post" action="@Url.Action("CancelReservation", "Reservation")" id="cancelForm-@reserva.ID_Reserva">
                            <input type="hidden" name="reservationId" value="@reserva.ID_Reserva" />
                            @Html.AntiForgeryToken()
                        </form>
                        <button class="btn-small btn-small-danger" onclick="pedirCancelar(@reserva.ID_Reserva)">
                            Cancelar
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal cancelar reserva -->
<div id="modalCancelar" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:12px; padding:40px; max-width:400px; width:90%;">
        <div style="text-align:center; margin-bottom:20px;">
            <div style="font-size:3rem; margin-bottom:12px;">⚠️</div>
            <h3 style="color:#dc2626; margin-bottom:8px;">Cancelar Reserva</h3>
            <p style="color:#6b7280; margin:0;">¿Estás seguro de que deseas cancelar esta reserva? Esta acción no se puede deshacer.</p>
        </div>
        <div style="display:flex; gap:10px;">
            <button onclick="confirmarCancelar()" style="flex:1; background:linear-gradient(135deg,#dc2626,#b91c1c); color:white; border:none; padding:12px; border-radius:8px; font-weight:600; cursor:pointer;">Sí, cancelar</button>
            <button onclick="cerrarModalCancelar()" style="flex:1; background:white; color:#6b7280; border:2px solid #e5e7eb; padding:12px; border-radius:8px; font-weight:600; cursor:pointer;">Volver</button>
        </div>
    </div>
</div>

<script>
    let _cancelarId = null;

    function pedirCancelar(id) {
        _cancelarId = id;
        document.getElementById('modalCancelar').style.display = 'flex';
    }

    function cerrarModalCancelar() {
        document.getElementById('modalCancelar').style.display = 'none';
        _cancelarId = null;
    }

    function confirmarCancelar() {
        if (_cancelarId) {
            document.getElementById('cancelForm-' + _cancelarId).submit();
        }
    }
</script>
