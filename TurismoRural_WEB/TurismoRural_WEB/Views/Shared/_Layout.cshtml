@using Microsoft.AspNetCore.Http
@{
    var usuario = Context.Session.GetString("NombreUsuario");
    var rol = Context.Session.GetString("RolUsuario");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Turismo Rural</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TurismoRural_WEB.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-success" asp-controller="Home" asp-action="Index">
                    Turismo Rural
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- IZQUIERDA -->
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @if (!string.IsNullOrEmpty(usuario))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Profile">
                                    Perfil
                                </a>
                            </li>

                            @if (rol == "1")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Users">
                                        Administrar Usuarios
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- CENTRO -->
                    <ul class="navbar-nav mx-auto">
                        @if (!string.IsNullOrEmpty(usuario))
                        {
                            <li class="nav-item">
                                <span class="nav-link fw-bold text-success">
                                    👤 Hola, @usuario
                                </span>
                            </li>
                        }
                    </ul>
                       
                    @{
                        var usuarioLogueado = Context.Session.GetInt32("UsuarioId") != null;
                        var esAdmin = Context.Session.GetString("RolUsuario") == "1";
                    }

                    @if (usuarioLogueado)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reservation" asp-action="Create">
                                    ✏️ Agregar Reserva
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reservation" asp-action="MyReservations">
                                    📋 Mis Reservas
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reservation" asp-action="SearchReservations">
                                    🔍 Buscar Reservas
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reservation" asp-action="AllReservations">
                                    📋 Todas las Reservas
                                </a>
                            </li>
                        </ul>
                    }

                    <ul class="navbar-nav ms-auto">

                        @if (string.IsNullOrEmpty(usuario))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">
                                    Registro
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">
                                    🔒 Cerrar Sesión
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2026 - Turismo Rural -
            <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
