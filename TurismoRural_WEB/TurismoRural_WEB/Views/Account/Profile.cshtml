@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Perfil";

    var nombre = Context.Session.GetString("NombreUsuario");
    var correo = Context.Session.GetString("CorreoUsuario");
    var rol = Context.Session.GetString("RolUsuario");
    var rolTexto = rol == "1" ? "Administrador" : "Usuario";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card auth-card p-4">
                <h2 class="mb-4 text-center">Perfil del Usuario</h2>

                @if (!string.IsNullOrEmpty(nombre))
                {
                    <p><strong>Nombre:</strong> @nombre</p>
                    <p><strong>Correo:</strong> @correo</p>
                    <p><strong>Rol:</strong> @rolTexto</p>
                }
                else
                {
                    <div class="alert alert-warning">
                        No hay información del usuario.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

