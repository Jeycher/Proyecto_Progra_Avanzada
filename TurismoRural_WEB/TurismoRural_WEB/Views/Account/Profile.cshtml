@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Perfil";

    var usuarioId = Context.Session.GetInt32("UsuarioId");
    var nombre = Context.Session.GetString("NombreUsuario");
    var correo = Context.Session.GetString("CorreoUsuario");
    var token = Context.Session.GetString("TokenUsuario");
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card auth-card p-4">
                <h2 class="mb-4 text-center">Perfil del Usuario</h2>

                @if (!string.IsNullOrEmpty(nombre))
                {
                    <p><strong>ID:</strong> @usuarioId</p>
                    <p><strong>Nombre:</strong> @nombre</p>
                    <p><strong>Correo:</strong> @correo</p>
                    <div class="mt-4">
                        <a href="@Url.Action("Logout", "Account")" class="btn btn-danger">Cerrar Sesión</a>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        No hay información del usuario.
                    </div>
                }
            </div>
        </div>
    </div>
</div>