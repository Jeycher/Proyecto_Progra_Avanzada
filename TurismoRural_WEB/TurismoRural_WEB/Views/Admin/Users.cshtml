@model List<TurismoRural_WEB.Models.UserViewModel>

@{
    ViewData["Title"] = "Administrar Usuarios";
}

<div class="container mt-5">
    <div class="card auth-card p-4">
        <h2 class="mb-4 text-center">Administración de Usuarios</h2>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-success">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th>Fecha Registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var rolTexto = user.id_Rol == 1 ? "Administrador" : "Usuario";

                            <tr>
                                <td>@user.id_Usuario</td>
                                <td>@user.nombre</td>
                                <td>@user.correo</td>
                                <td>@user.telefono</td>
                                <td>@rolTexto</td>
                                <td>@user.fecha_Registro.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@user.id_Usuario"
                                       class="btn btn-sm btn-primary">
                                        Editar
                                    </a>

                                    <form asp-controller="Admin" asp-action="DeleteUser" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@user.id_Usuario" />
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('¿Deseas eliminar este usuario?');">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                No hay usuarios registrados.
            </div>
        }
    </div>
</div>        }
    </div>
</div>
