@model TurismoRural_WEB.Models.UserEditViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-5">
    <div class="card auth-card p-4">
        <h2 class="mb-4 text-center">Editar Usuario</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="id_Usuario" />

            <div class="mb-3">
                <label asp-for="nombre" class="form-label"></label>
                <input asp-for="nombre" class="form-control" />
                <span asp-validation-for="nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="correo" class="form-label"></label>
                <input asp-for="correo" class="form-control" />
                <span asp-validation-for="correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="telefono" class="form-label"></label>
                <input asp-for="telefono" class="form-control" />
                <span asp-validation-for="telefono" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="id_Rol" class="form-label">Rol</label>
                <select asp-for="id_Rol" class="form-control">
                    <option value="1">Administrador</option>
                    <option value="2">Usuario</option>
                </select>
                <span asp-validation-for="id_Rol" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Guardar Cambios</button>
            <a asp-controller="Admin" asp-action="Users" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>
