@{
    ViewData["Title"] = "Inicio";
    var usuario = Context.Session.GetString("NombreUsuario");
    var registroExitoso = Context.Session.GetString("RegistroExitoso");
}

@if (!string.IsNullOrEmpty(usuario) || registroExitoso == "true")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin-top: 20px;">
        <strong>¡Bienvenido!</strong> Hola @(usuario ?? ""), acceso concedido al sistema.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    Context.Session.Remove("RegistroExitoso");
}

<div class="hero-section">
    <div class="hero-content">
        <h1>Descubre la magia del Turismo Rural</h1>
        <p>Vive experiencias auténticas, apoya comunidades locales y conecta con la naturaleza.</p>

        @if (string.IsNullOrEmpty(usuario))
        {
            <a class="btn btn-success btn-lg me-2" asp-controller="Account" asp-action="Register">
                Registrarse
            </a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">
                Iniciar Sesión
            </a>
        }
    </div>
</div>
