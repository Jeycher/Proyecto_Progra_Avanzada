@page
@model TurismoRural_WEB.Pages.SesionesModel
@{
    ViewData["Title"] = "Sesiones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/reservations.css" />

<input type="hidden" id="esAdmin" value="@Model.EsAdmin.ToString().ToLower()" />

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>🗓 Sesiones de la Experiencia</h1>
        <p>@(Model.EsAdmin ? "Gestiona las sesiones disponibles para esta experiencia." : "Elige una sesion y realiza tu reserva.")</p>
    </div>

    @if (Model.EsAdmin)
    {
        <div style="margin-bottom: 30px; text-align: right;">
            <button class="card-button" onclick="mostrarModalCrear()" style="background: linear-gradient(135deg, #10b981, #059669); padding: 12px 24px;">Agregar Nueva Sesion</button>
        </div>
    }

    <div id="sesionesContent">
        <div style="text-align: center; padding: 40px; color: #10b981; font-weight: 600;">Cargando sesiones...</div>
    </div>

    <div class="footer-section">
        <a id="btnVolver" href="#" class="back-button">Volver a Experiencias</a>
    </div>
</div>

@if (Model.EsUsuario)
{
    <div id="modalReservar" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
        <div style="background:white; border-radius:12px; padding:40px; max-width:400px; width:90%;">
            <h3 style="color:#10b981; margin-bottom:20px;">🏕 Reservar Sesión</h3>
            <input type="hidden" id="reservarConcurrenciaId" />
            <div style="margin-bottom:20px;">
                <label style="font-weight:600; color:#333; display:block; margin-bottom:8px;">Cantidad de Personas:</label>
                <input type="number" id="cantidadPersonas" min="1" value="1" style="width:100%; padding:12px; border:2px solid #e5e7eb; border-radius:8px; font-size:1rem;" />
            </div>
            <div style="display:flex; gap:10px;">
                <button onclick="confirmarReserva()" class="card-button" style="flex:1; background:linear-gradient(135deg,#10b981,#059669);">Confirmar</button>
                <button onclick="cerrarModalReservar()" class="card-button" style="flex:1; background:white; color:#10b981; border:2px solid #10b981;">Cancelar</button>
            </div>
            <div id="reservaMsg" style="margin-top:15px; display:none;"></div>
        </div>
    </div>
}

@if (Model.EsAdmin)
{
    <div id="modalCrear" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
        <div style="background:white; border-radius:12px; padding:40px; max-width:480px; width:90%; max-height:90vh; overflow-y:auto;">
            <h3 id="modalCrearTitulo" style="color:#10b981; margin-bottom:20px;">📅 Nueva Sesión</h3>
            <input type="hidden" id="editarId" value="0" />
            <div style="margin-bottom:15px;">
                <label style="font-weight:600; color:#333; display:block; margin-bottom:8px;">Detalle:</label>
                <input type="text" id="inputDetalle" style="width:100%; padding:12px; border:2px solid #e5e7eb; border-radius:8px; font-size:1rem;" />
            </div>
            <div style="margin-bottom:15px;">
                <label style="font-weight:600; color:#333; display:block; margin-bottom:8px;">Fecha y Hora:</label>
                <input type="datetime-local" id="inputFecha" style="width:100%; padding:12px; border:2px solid #e5e7eb; border-radius:8px; font-size:1rem;" />
            </div>
            <div style="margin-bottom:15px;">
                <label style="font-weight:600; color:#333; display:block; margin-bottom:8px;">Precio:</label>
                <input type="number" id="inputPrecio" min="0" step="0.01" style="width:100%; padding:12px; border:2px solid #e5e7eb; border-radius:8px; font-size:1rem;" />
            </div>
            <div style="margin-bottom:20px;">
                <label style="font-weight:600; color:#333; display:block; margin-bottom:8px;">Cupos Disponibles:</label>
                <input type="number" id="inputCupos" min="1" style="width:100%; padding:12px; border:2px solid #e5e7eb; border-radius:8px; font-size:1rem;" />
            </div>
            <div style="display:flex; gap:10px;">
                <button onclick="guardarSesion()" class="card-button" style="flex:1; background:linear-gradient(135deg,#10b981,#059669);">Guardar</button>
                <button onclick="cerrarModalCrear()" class="card-button" style="flex:1; background:white; color:#10b981; border:2px solid #10b981;">Cancelar</button>
            </div>
            <div id="crearMsg" style="margin-top:15px; display:none;"></div>
        </div>
    </div>
}

@section Scripts {
<script>
    const esAdmin = document.getElementById('esAdmin').value === 'true';
    const urlParams = new URLSearchParams(window.location.search);
    const experienciaId = parseInt(urlParams.get('experienciaId') || '0');

    document.getElementById('btnVolver').href = esAdmin ? '/Experiencias' : '/ExperienciasReservar';

    async function cargarSesiones() {
        try {
            const url = window.location.pathname + '?handler=GetExperiencias&experienciaId=' + experienciaId;
            const response = await fetch(url);
            if (!response.ok) throw new Error('Error ' + response.status);
            const data = await response.json();
            renderizarSesiones(data);
        } catch (error) {
            document.getElementById('sesionesContent').innerHTML =
                '<div style="text-align:center;padding:60px 20px;background:#f0fdf4;border-radius:12px;">' +
                '<div style="font-size:4rem;">error</div>' +
                '<h3 style="color:#10b981;">Error al cargar sesiones</h3>' +
                '<p style="color:#999;">' + error.message + '</p>' +
                '<button class="card-button" onclick="cargarSesiones()" style="background:linear-gradient(135deg,#10b981,#059669);color:white;padding:12px 24px;border:none;border-radius:8px;cursor:pointer;">Reintentar</button>' +
                '</div>';
        }
    }

    function renderizarSesiones(sesiones) {
        const contenido = document.getElementById('sesionesContent');
        if (!sesiones || sesiones.length === 0) {
            contenido.innerHTML =
                '<div style="text-align:center;padding:60px 20px;background:#f0fdf4;border-radius:12px;">' +
                '<div style="font-size:4rem;">vacio</div>' +
                '<h3 style="color:#10b981;">No hay sesiones disponibles</h3>' +
                '<p style="color:#666;">No se encontraron sesiones para esta experiencia.</p>' +
                '</div>';
            return;
        }

        let html = '<div class="cards-grid">';
        sesiones.forEach(function(s) {
            const id = s.iD_Concurrencia !== undefined ? s.iD_Concurrencia : (s.id_Concurrencia !== undefined ? s.id_Concurrencia : (s.id || 0));
            const detalle = s.detalle || s.Detalle || 'Sin detalle';
            const fecha = s.fecha || s.Fecha || '';
            const precio = s.precio !== undefined ? s.precio : (s.Precio !== undefined ? s.Precio : 0);
            const cupos = s.cupos_Disponibles !== undefined ? s.cupos_Disponibles : (s.cuposDisponibles !== undefined ? s.cuposDisponibles : (s.Cupos_Disponibles || 0));

            const fechaFormateada = fecha
                ? new Date(fecha).toLocaleDateString('es-CR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })
                : 'Sin fecha';

            let botones = '';
            if (esAdmin) {
                botones =
                    '<button onclick="editarSesion(' + id + ', \'' + detalle.replace(/'/g, "\\'") + '\', \'' + fecha + '\', ' + precio + ', ' + cupos + ')" class="card-button" style="flex:1; background:linear-gradient(135deg,#f59e0b,#d97706); color:white; padding:10px; font-size:0.85rem; border:none; cursor:pointer;">Editar</button>' +
                    '<button onclick="eliminarSesion(' + id + ')" class="card-button" style="flex:1; background:linear-gradient(135deg,#ef4444,#dc2626); color:white; padding:10px; font-size:0.85rem; border:none; cursor:pointer;">Eliminar</button>';
            } else {
                botones =
                    '<button onclick="reservar(' + id + ')" class="card-button" style="flex:1; background:linear-gradient(135deg,#10b981,#059669); color:white; padding:10px; font-size:0.85rem; border:none; cursor:pointer;">Reservar</button>';
            }

            html +=
                '<div class="card-module">' +
                '<div class="card-icon" style="background:linear-gradient(135deg,#10b981,#34d399); font-size:2rem;">&#x1F305;</div>' +
                '<div class="card-content">' +
                '<div class="card-title">' + detalle + '</div>' +
                '<p class="card-description">' + fechaFormateada + '</p>' +
                '<div style="display:flex;justify-content:space-between;padding:15px 0;border-top:1px solid #e5e7eb;margin-bottom:15px;">' +
                '<div><div style="font-size:0.75rem;color:#999;">Precio</div><span style="font-size:1.1rem;font-weight:700;color:#10b981;">\u20a1' + Number(precio).toLocaleString() + '</span></div>' +
                '<div style="text-align:right;"><div style="font-size:0.75rem;color:#999;">Cupos disponibles</div><span style="font-size:1.1rem;font-weight:700;color:#10b981;">' + cupos + '</span></div>' +
                '</div>' +
                '<div style="display:flex;gap:10px;">' + botones + '</div>' +
                '</div></div>';
        });
        html += '</div>';
        contenido.innerHTML = html;
    }

    function reservar(concurrenciaId) {
        window.location.href = '/Reservation/Create?concurrenciaId=' + concurrenciaId;
    }

        function mostrarModalCrear() {
        document.getElementById('modalCrearTitulo').textContent = '📅 Nueva Sesión';
        document.getElementById('editarId').value = '0';
        document.getElementById('inputDetalle').value = '';
        document.getElementById('inputFecha').value = '';
        document.getElementById('inputPrecio').value = '';
        document.getElementById('inputCupos').value = '';
        const msg = document.getElementById('crearMsg');
        if (msg) { msg.style.display = 'none'; msg.innerHTML = ''; }
        document.getElementById('modalCrear').style.display = 'flex';
    }

    function editarSesion(id, detalle, fecha, precio, cupos) {
        document.getElementById('modalCrearTitulo').textContent = '✏️ Editar Sesión';
        document.getElementById('editarId').value = id;
        document.getElementById('inputDetalle').value = detalle;
        document.getElementById('inputFecha').value = fecha ? fecha.substring(0, 16) : '';
        document.getElementById('inputPrecio').value = precio;
        document.getElementById('inputCupos').value = cupos;
        const msg = document.getElementById('crearMsg');
        if (msg) { msg.style.display = 'none'; msg.innerHTML = ''; }
        document.getElementById('modalCrear').style.display = 'flex';
    }

    function cerrarModalCrear() {
        document.getElementById('modalCrear').style.display = 'none';
    }

    async function guardarSesion() {
        const id = parseInt(document.getElementById('editarId').value);
        const data = {
            iD_Experiencia: experienciaId,
            detalle: document.getElementById('inputDetalle').value,
            fecha: document.getElementById('inputFecha').value,
            precio: parseFloat(document.getElementById('inputPrecio').value),
            cupos_Disponibles: parseInt(document.getElementById('inputCupos').value)
        };
        const msg = document.getElementById('crearMsg');
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]') ? document.querySelector('input[name="__RequestVerificationToken"]').value : '';
            const url = id > 0
                ? window.location.pathname + '?handler=Update&id=' + id
                : window.location.pathname + '?handler=Create';
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
                cerrarModalCrear();
                cargarSesiones();
            } else {
                msg.style.display = 'block';
                msg.innerHTML = '<span style="color:#ef4444;">No se pudo guardar la sesion.</span>';
            }
        } catch (error) {
            msg.style.display = 'block';
            msg.innerHTML = '<span style="color:#ef4444;">Error: ' + error.message + '</span>';
        }
    }

    async function eliminarSesion(id) {
        if (!confirm('Esta seguro de que desea eliminar esta sesion?')) return;
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]') ? document.querySelector('input[name="__RequestVerificationToken"]').value : '';
            const response = await fetch(window.location.pathname + '?handler=Delete&id=' + id, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const result = await response.json();
            if (result.success) {
                cargarSesiones();
            } else {
                alert('No se pudo eliminar la sesion.');
            }
        } catch (error) {
            alert('Error: ' + error.message);
        }
    }

    window.addEventListener('load', cargarSesiones);
</script>
}




